# Configuration locale de Docker Compose.
#
#   cp .env.example .env
#
# .env est ignoré par git. Ce fichier-ci ne contient que des valeurs fictives,
# suffisantes pour démarrer en local ; changez-les pour tout autre usage.

# --- PostgreSQL local (service db) ---
POSTGRES_USER=quiz_user
# Lettres et chiffres uniquement : la valeur est insérée telle quelle dans
# l'URL de connexion du backend.
POSTGRES_PASSWORD=quiz_password
POSTGRES_DB=quiz_db

# --- Backend ---
# Le backend refuse de démarrer sans clé Resend : une valeur factice suffit
# tant que l'envoi d'email n'est pas configuré (les envois échouent alors,
# sans bloquer l'enregistrement des Résultats).
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL="Quiz App <noreply@votredomaine.com>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Générer une vraie valeur avec : openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# --- Frontend ---
# Port publié sur le poste ; l'application est alors sur http://localhost:8087
FRONTEND_PORT=8087
