# Modèle traité au démarrage par l'image Nginx officielle : chaque
# ${VARIABLE} définie dans l'environnement est remplacée, puis le
# résultat est écrit dans /etc/nginx/conf.d/default.conf.
#
# BACKEND_ORIGIN : adresse du backend vue depuis ce conteneur.
#   - Docker Compose : http://backend:3007
#   - Azure Container Apps : https://ca-quiz-backend.internal.<domaine>
#   L'en-tête Host envoyé au backend reste celui de BACKEND_ORIGIN (comportement
#   par défaut de proxy_pass) : sur Container Apps, c'est ce nom qui permet au
#   proxy de la plateforme de router la requête vers la bonne application.
#
# TRUSTED_PROXY_CIDR : d'où peut venir un proxy dont on croit X-Forwarded-For.
#   - Docker Compose : 127.0.0.1/32, c'est-à-dire personne (rien devant Nginx)
#   - Azure Container Apps : 0.0.0.0/0, car tout le trafic passe par le proxy
#     de la plateforme, qui ajoute l'adresse réelle du client en dernier.

# Schéma d'origine : celui annoncé par le proxy devant Nginx s'il existe
# (HTTPS sur Container Apps), sinon celui de la connexion.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # Adresse réelle du client : dernière entrée de X-Forwarded-For, ajoutée
    # par le proxy de confiance (real_ip_recursive off).
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    include /etc/nginx/snippets/security-headers.conf;

    # Fichiers produits par Vite : leur nom contient un hash du contenu, donc
    # ils peuvent rester en cache un an sans risque de servir une vieille version.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Pages et fichiers non hachés : toujours revalidés, pour qu'un déploiement
    # (par exemple une Question modifiée) soit visible immédiatement.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Page d'administration
    location = /gestion-quiz {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /gestion-quiz.html =404;
    }

    # API relayée vers le backend
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        include /etc/nginx/snippets/proxy.conf;
    }

    # Santé du backend, exposée via le frontend
    location = /health {
        proxy_pass ${BACKEND_ORIGIN};
        include /etc/nginx/snippets/proxy.conf;
    }
}
